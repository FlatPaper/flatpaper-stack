  "cards": [
    {
      "dot": "rose",
      "title": "Always on",
      "items": [
        "SessionStart prints guidelines.md and runs arch-drift.sh",
        "UserPromptSubmit adds a one-line reminder",
        "arch-drift.sh flags commits since built_from_sha, or a changed evidence.release"
      ]
    },
    {
      "dot": "emerald",
      "title": "flatpaper-mode",
      "items": [
        "Start: restate, read repo rules, match one of 15 playbooks, read principles.md",
        "Each playbook step and Finish step becomes a task",
        "Finish step 2 runs Opening a PR; written repo rules replace only its format defaults",
        "A PreToolUse hook blocks gh pr create until tidy, no-comments, technical-writing, and unslop ran",
        "Re-match on every prompt when the kind of work changes"
      ]
    },
    {
      "dot": "violet",
      "title": "Standalone skills",
      "items": [
        "Playbook steps call why, architect, interrogate, swarm, arena, tidy, no-comments, unslop, technical-writing",
        "By hand only: correct, reflect, recall, ketchup, sharpen, flatpaper-help, blast-radius, the verification and formal verification skills",
        "show-me-your-work keeps the decision log",
        "Subagents run on opus, sonnet, haiku, or fable, with effort set per spawn"
      ]
    },
    {
      "dot": "amber",
      "title": "Plugin agents",
      "items": [
        "flatpaper-agent: playbook delegates read flatpaper-mode, principles, and guidelines first",
        "comment-sicko: spawned by no-comments, edits comments only",
        "flatpaper-mode is by hand, so subagents reach it only through flatpaper-agent",
        "check-skills.sh and the guide build check every agent"
      ]
    }
  ]
