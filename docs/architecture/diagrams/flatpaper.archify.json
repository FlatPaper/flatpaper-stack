  "cards": [
    {
      "dot": "rose",
      "title": "Always on",
      "items": [
        "SessionStart prints guidelines.md and runs arch-drift.sh",
        "UserPromptSubmit adds a one-line reminder",
        "arch-drift.sh flags commits since built_from_sha, or a changed evidence.release"
      ]
    },
    {
      "dot": "emerald",
      "title": "flatpaper-mode",
      "items": [
        "Start: restate, read repo rules, match one of 22 playbooks (a Feature, Bug fix, Refactoring, or Perf story of 3+ PRs goes to Multi-phase plan), read principles.md",
        "Each playbook step and Finish step becomes a task",
        "Finish step 2 runs Opening a PR; written repo rules replace only its format defaults",
        "A PreToolUse hook blocks gh pr create until tidy, no-comments, technical-writing, and unslop ran",
        "Merges are user-granted: Orchestrate and Autopilot-full owners after the user's go, Shipping on an explicit request to land",
        "Re-match on every prompt when the kind of work changes"
      ]
    },
    {
      "dot": "violet",
      "title": "Standalone skills",
      "items": [
        "Playbook steps call how, why, architect, interrogate, swarm, arena, tidy, no-comments, unslop, technical-writing, statechart, benchmark-checklist; large work that fits in one run, or no match, routes to figure-it-out",
        "With no verify-<app> skill, Driving the app uses control-ui for a browser or Electron UI and control-cli for a CLI or TUI",
        "By hand only: correct, reflect, recall, ketchup, ketchup-video, teach, bro, sharpen, flatpaper-help, blast-radius, the verification and formal verification skills",
        "show-me-your-work keeps the decision log",
        "Subagents run on opus, sonnet, haiku, or fable per a role table that also sets each role's effort; interrogate, arena, and architect panels and swarm read-only races pair a read-only Codex seat, run first through codex-seat.sh, with opus, and the arena and Eval judges run on Codex"
      ]
    },
    {
      "dot": "amber",
      "title": "Plugin agents",
      "items": [
        "flatpaper-agent: playbook delegates read flatpaper-mode, principles, and guidelines first; an autopilot or orchestrate owner runs its own PR, and merges it under Autopilot-full or Orchestrate",
        "comment-sicko: spawned by no-comments, edits comments only, runs on opus",
        "flatpaper-mode is by hand, so subagents reach it only through flatpaper-agent",
        "check-skills.sh and the guide build check every agent"
      ]
    }
  ]
